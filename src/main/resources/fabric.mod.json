{
  "schemaVersion": 1,
  "id": "councilcraft",
  "version": "${version}",
  "name": "CouncilCraft",
  "description": "Gameplay hooks for the CouncilCraft vanilla+ pack. Required on the client and the server.",
  "authors": [
    "CouncilCraft"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.councilcraft.CouncilCraft"
    ],
    "client": [
      "dev.councilcraft.CouncilCraftClient"
    ],
    "controlify": [
      "dev.councilcraft.client.compat.ControlifyQuiverCycle"
    ]
  },
  "mixins": [
    "councilcraft.mixins.json",
    {
      "config": "councilcraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "horseshoes": "*",
    "mutantmonsters": "*",
    "paraglider": "*",
    "supplementaries": "*",
    "create": "*",
    "numismatics": "*",
    "pehkui": "*",
    "create_enchantment_industry": "*",
    "exposure": "*"
  },
  "suggests": {
    "inventorio": "*",
    "antique_atlas": "*",
    "nameplate": "*",
    "geckolib": "*",
    "distanthorizons": "*",
    "imm_ptl_core": "*"
  }
}
