+// CouncilCraft patch: clip q towards the centre of an AABB (Complementary/Playdead style).
+vec3 cc_clip_aabb(vec3 q, vec3 aabb_min, vec3 aabb_max) {
+    vec3 p_clip = 0.5 * (aabb_max + aabb_min);
+    vec3 e_clip = 0.5 * (aabb_max - aabb_min) + 0.00000001;
+    vec3 v_clip = q - p_clip;
+    vec3 a_unit = abs(v_clip / e_clip);
+    float ma_unit = max(a_unit.x, max(a_unit.y, a_unit.z));
+    return (ma_unit > 1.0) ? p_clip + v_clip / ma_unit : q;
+}
 
