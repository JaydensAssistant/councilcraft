+// CouncilCraft patch: tuning constants (plain consts, NOT #defines, so they
+// never show up as shader options and existing settings files still import).
+const float CC_TAA_BLEND_FLAT        = 0.80;  // history weight on flat areas (stock 0.65)
+const float CC_TAA_BLEND_DEPTH_EDGE  = 0.50;  // history weight on depth / sky edges (camera still)
+const float CC_TAA_BLEND_MOVING_EDGE = 0.10;  // ... on depth edges while the camera moves
+const float CC_TAA_COLOR_EDGE_DROP   = 0.10;  // less history on high-contrast colour edges
+const float CC_TAA_VARIANCE_GAMMA    = 1.25;  // variance clip width (sigmas)
+const float CC_TAA_DEPTH_REL_EDGE    = 0.12;  // relative depth jump that counts as an edge
+const float CC_TAA_TELEPORT_DIST     = 8.0;   // blocks/frame; above this history is dropped
+const float CC_SKY_DIST              = 65536.0; // pseudo distance for sky (and DH) pixels
+// v2a: stock resolve is faded in between these fractions of the DH fade start
+// (the distance where vanilla chunks start being dithered away).
+const float CC_DH_BAND_LO            = 0.60;
+const float CC_DH_BAND_HI            = 0.85;
+
+// CouncilCraft patch v2a: view-space distance in blocks of the opaque VANILLA
+// depth at uv (same measure as gl_FogFragCoord in position_vertex.glsl).
+// Sky - and Distant Horizons terrain, which is not in depthtex1 - return
+// CC_SKY_DIST, i.e. they are treated the way stock composite2 treats them.
+float cc_taa_view_dist(vec2 uv) {
+    float z = texture2DLod(depthtex1, uv, 0.0).r;
+    if (z >= 1.0) {
+        return CC_SKY_DIST;
+    }
+    vec4 view_pos = gbufferProjectionInverse * vec4(vec3(uv, z) * 2.0 - 1.0, 1.0);
+    return length(view_pos.xyz / view_pos.w);
+}
 
