+vec3 fast_taa(vec3 current_color, vec2 texcoord_past) {
+    // CouncilCraft patch: was loose sphere clamp + mix(current, previous, 0.65 + edge * 0.25).
+    vec3 previous = texture2DLod(colortex3, texcoord_past, 0.0).rgb;
+    return cc_taa_resolve(current_color, texcoord_past, previous).rgb;
+}
+
+vec4 fast_taa_depth(vec4 current_color, vec2 texcoord_past) {
+    // CouncilCraft patch: DOF variant, same resolve; alpha keeps stock behaviour
+    // (history alpha blended with the same weight).
+    vec4 previous = texture2DLod(colortex3, texcoord_past, 0.0);
+    vec4 resolved = cc_taa_resolve(current_color.rgb, texcoord_past, previous.rgb);
+    return vec4(resolved.rgb, mix(current_color.a, previous.a, resolved.a));
+}
