{
	// CouncilCraft PPM22: much rarer than the mod's default 8. Bastion treasure pool 0 (3 rolls, vanilla weight 106): 8 = ~19.6% of chests, 1 = ~2.8%.
	// The weight you want the netherite horse armor to be in the loot table (bastion treasure). Requires /reload command to work if changed in game. Set to 0 to disable loot generation. (default: 8)
	"weight": 1,
	// The armor points you want for the netherite horse armor. (default: 13)
	"protectionValue": 13,
	// CouncilCraft PPM22: smithing upgrade on (diamond horse armor + netherite ingot + netherite upgrade template).
	// Whether you can upgrade a diamond horse armor into a netherite one with smithing table. (default: false)
	"easyCrafting": true
}
